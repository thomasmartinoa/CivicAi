# ─── Environment ───────────────────────────────────────────
# "development" | "staging" | "production". Guards dev-only endpoints such
# as POST /admin/seed. Defaults to production (fails closed) when unset —
# set this to enable development-only endpoints.
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────
# SQLite (default for local dev — no setup needed)
DATABASE_URL=sqlite:///./civicai.db
# PostgreSQL (production/Docker): DATABASE_URL=postgresql://civicai:civicai@localhost:5432/civicai

# ─── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OTP_EXPIRE_MINUTES=10

# Dev seed credentials for POST /admin/seed. Only ever used when
# ENVIRONMENT=development.
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_PASSWORD=officer123

# ─── LLM providers (used from Phase 1 onward) ──────────────
# Google Gemini — get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Local Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Email / SMTP ──────────────────────────────────────────
# Local dev: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ─── Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
