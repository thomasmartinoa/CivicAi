# ─── Environment ───────────────────────────────────────────
# "development" | "staging" | "production". Guards dev-only endpoints such
# as POST /admin/seed. Defaults to production (fails closed) when unset —
# set this to enable development-only endpoints.
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────
# SQLite (default for local dev — no setup needed)
DATABASE_URL=sqlite:///./civicai.db
# PostgreSQL (production/Docker): DATABASE_URL=postgresql://civicai:civicai@localhost:5432/civicai

# ─── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OTP_EXPIRE_MINUTES=10

# Dev seed credentials for POST /admin/seed. Only ever used when
# ENVIRONMENT=development.
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_PASSWORD=officer123

# ─── LLM providers (used from Phase 1 onward) ──────────────
# Google Gemini — get key at: https://aistudio.google.com/app/apikey
# Model ids are retired without warning; a 404 NOT_FOUND from every LLM node
# means these two need checking against the live /v1beta/models list.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger model used for judgement-heavy steps (risk assessment) and prose
# generation (narration/briefing), per TASK_MODEL in app/ai/llm.py.
GEMINI_MODEL_STRONG=gemini-3.5-flash

# Local Ollama fallback. OLLAMA_BASE_URL and OLLAMA_MODEL below are inert
# unless OLLAMA_ENABLED=true, and using it also requires
# `pip install langchain-ollama` (deliberately not in requirements.txt).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Shared ceiling for all LLM calls and the client's own per-call retry count.
# The Gemini free tier rate-limits aggressively; tuned for Phase 3's eval
# sweep rather than a live demo — see the comment on SHARED_RATE_LIMITER in
# app/ai/llm.py.
# The Gemini free tier allows 15 generate requests per minute per model
# (GenerateRequestsPerMinutePerProjectPerModel-FreeTier), which is 0.25/s. 0.2
# leaves headroom for the limiter's burst bucket. Measured the hard way: at 2.0 a
# 100-item eval sweep hit 429s within the first minute.
LLM_REQUESTS_PER_SECOND=0.2
# Retries inside the provider's own client. These bypass the shared rate limiter,
# so on a quota-limited tier they make a 429 storm self-amplifying: one gated call
# fires several ungated HTTP requests, each counting against the 15/minute free-tier
# limit. Keep it 0 and let the chain's own gated retry handle failures.
LLM_MAX_RETRIES=0
# Seconds before a single model request is abandoned. A stalled connection must
# fail so the node can record it, rather than hanging the run for ever.
LLM_TIMEOUT_SECONDS=60

# ─── RAG (Phase 2) ─────────────────────────────────────────
# Embedding model to use for RAG. Must be available from the LLM provider.
EMBEDDING_MODEL=gemini-embedding-001
# Directory to store and load vector indices. Each collection (policy, cases)
# gets its own subdirectory.
RAG_INDEX_DIR=./data/index
# Reuse a previous completion when a new prompt is a near-duplicate of it --
# the burst of reports one incident produces. In memory, per process.
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity a prompt must reach to be served from the cache. Lower
# saves more calls and risks serving a stale answer to a different question.
SEMANTIC_CACHE_THRESHOLD=0.95
# Run the scheduled jobs (the SLA monitor, every 5 minutes). One process runs
# them: with several workers, every worker would run every job.
BACKGROUND_JOBS_ENABLED=true
# Clustering: reports within this many kilometres of each other and above this
# cosine similarity are treated as one job once there are CLUSTER_MIN_SIZE of them.
CLUSTER_RADIUS_KM=0.5
CLUSTER_SIMILARITY_THRESHOLD=0.82
CLUSTER_MIN_SIZE=3
# Individual job switches, under BACKGROUND_JOBS_ENABLED. The SLA monitor has no
# switch of its own: a warning email that never arrives is a silent failure.
CLUSTER_DETECTION_ENABLED=true
BRIEFING_ENABLED=true
CASES_REFRESH_ENABLED=true
# Local hour the officer briefing is written; the cases index refreshes an hour before.
BRIEFING_HOUR=8

# ─── Evaluation (Phase 3) ──────────────────────────────────────
# Path to a JSON file of per-token prices you were actually quoted, e.g.
# {"source": "Gemini pricing page, 2026-09-28", "per_million_input": 0.10,
#  "per_million_output": 0.40}. Left empty, every cost cell in the eval report
# reads "not configured" -- no rates are ever assumed.
EVAL_COST_RATES_FILE=

# ─── Observability (Phase 3) ───────────────────────────────────
# LangSmith tracing. Ignored unless both the flag and the key are set. The trace
# records internal ids, categories and risk scores -- never the complaint text,
# the address, contact details, or the tracking id (which is a read credential).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=civicai

# ─── Email / SMTP ──────────────────────────────────────────
# Local dev: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ─── Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
